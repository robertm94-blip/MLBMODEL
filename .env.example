# Shadow Maker bot — copy this file to .env and fill in your values.
# .env is gitignored; never commit real keys.

# Kalshi API key (UUID from your Kalshi account → API Keys page).
KALSHI_API_KEY=your-kalshi-api-key-uuid

# Absolute path to the RSA private key PEM file paired with that API key.
# The PEM file itself should live OUTSIDE the repo (e.g. ~/.kalshi/key.pem)
# so it's never staged for commit.
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem
